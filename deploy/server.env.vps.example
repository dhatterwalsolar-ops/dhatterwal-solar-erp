# Copy to /var/www/dhatterwal/server/.env on Hostinger VPS
# Password: /root/dhatterwal-db-password.txt (from vps-setup.sh) or your own

USE_PGLITE=false
DATABASE_URL=postgresql://erp:CHANGE_ME@127.0.0.1:5432/dhatterwal_erp
PGSSL=false
ERP_JWT_SECRET=change-me-long-random-secret
PORT=8787
NODE_ENV=production

# Optional messaging / GST — same keys as before, now only on VPS
SMS_PROVIDER=msg91
OTP_MOBILE=
OTP_TTL_MS=300000
MSG91_AUTH_KEY=
MSG91_SENDER_ID=DHTSOL
MSG91_OTP_TEMPLATE_ID=

WHATSAPP_PROVIDER=web
QUERY_ALERT_MOBILE=

GOOGLE_FORM_WEBHOOK_SECRET=change-me-long-random-secret

GST_API_PROVIDER=demo
GST_GSTIN=06JKPPK6453K1ZE
