# Local: PGlite (Docker ke bina)
USE_PGLITE=true
DATABASE_URL=pglite

# Hostinger VPS production (local Postgres on same machine):
# USE_PGLITE=false
# DATABASE_URL=postgresql://erp:PASSWORD@127.0.0.1:5432/dhatterwal_erp
# PGSSL=false

ERP_JWT_SECRET=dhatterwal-erp-dev-secret-change-me
PORT=8787

# ---------- Messaging: OTP SMS + WhatsApp ----------
# SMS: demo | msg91 | twilio
SMS_PROVIDER=msg91
OTP_MOBILE=9467564675
OTP_TTL_MS=300000

# MSG91 — https://control.msg91.com → Settings → API Keys (Authkey)
# OTP template: SMS → Templates (DLT) → variable ##OTP##
MSG91_AUTH_KEY=
MSG91_SENDER_ID=DHTSOL
MSG91_OTP_TEMPLATE_ID=

# Twilio SMS
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+1xxxx

# WhatsApp: web (browser fallback) | meta | twilio
WHATSAPP_PROVIDER=web
QUERY_ALERT_MOBILE=9467564675

# Google Form → BOM (Apps Script webhook)
# Random strong string — same secret Apps Script me paste karo
GOOGLE_FORM_WEBHOOK_SECRET=change-me-long-random-secret

# ---------- GST E-Invoice + E-Way Bill ----------
# demo = test IRN/EWB (default) | http = aapka GSP / ClearTax-style API
GST_API_PROVIDER=demo
# COMPANY_GSTIN / seller GSTIN
GST_GSTIN=06JKPPK6453K1ZE
